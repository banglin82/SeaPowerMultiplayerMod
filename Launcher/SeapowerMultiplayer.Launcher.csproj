<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>SeapowerMultiplayerLauncher</AssemblyName>
    <RootNamespace>SeapowerMultiplayer.Launcher</RootNamespace>
    <ApplicationIcon>SPM.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <ModDllPath Condition="'$(ModDllPath)' == ''">..\src\bin\Release\net472\merged\SeapowerMultiplayer.dll</ModDllPath>
  </PropertyGroup>

  <!-- Embed the merged plugin DLL; override its path with ModDllPath. -->
  <ItemGroup>
    <EmbeddedResource Include="$(ModDllPath)"
                      LogicalName="SeapowerMultiplayer.dll"
                      Condition="Exists('$(ModDllPath)')" />
  </ItemGroup>

  <Target Name="RequireModDll" BeforeTargets="BeforeBuild"
          Condition="'$(RequireModDll)' == 'true' And !Exists('$(ModDllPath)')">
    <Error Text="Mod DLL not found at $(ModDllPath). Build the merged plugin or set ModDllPath to its location." />
  </Target>

  <!-- BepInEx zip — user places this in Resources/ manually -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\BepInEx_win_x64_5.4.23.5.zip"
                      LogicalName="BepInEx.zip"
                      Condition="Exists('Resources\BepInEx_win_x64_5.4.23.5.zip')" />
  </ItemGroup>

</Project>
